# Normalize source files across Windows, macOS, and Linux.
* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.spec text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Keep screenshots and the demo workbook byte-for-byte.
*.jpg binary
*.jpeg binary
*.png binary
*.xlsx binary
